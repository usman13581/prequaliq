# Server Configuration
PORT=5000
NODE_ENV=development

# Database — local development (use these OR DATABASE_URL, not both)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prequaliq_db
DB_USER=postgres
DB_PASSWORD=your_password

# Database — production (Railway / hosted Postgres). Overrides DB_* when set.
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (CORS + email links)
FRONTEND_URL=http://localhost:5173

# App display name (emails)
# APP_NAME=PrequaliQ

# Self-hosted AI (Trooper GPU server — optional)
# After deploying ai-service/, copy AI_API_KEY from the GPU server's .env
AI_SERVICE_URL=http://connect01.trooper.ai:22528
AI_API_KEY=your_gpu_server_api_key_from_ai-service/.env

# API docs (Swagger UI at /api-docs; links to GPU docs when AI_SERVICE_URL is set)
# API_PUBLIC_URL=http://localhost:5001

# Email — SMTP (Hostinger)
EMAIL_FROM=info@Prequaliq.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@Prequaliq.com
SMTP_PASS=your_hostinger_email_password

# Email — Resend (optional alternative to SMTP)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=info@yourdomain.com
