# Copy to deploy.env and set SSH + public API port for your GPU host.
# Works for Trooper OR any monthly GPU VPS (names kept for script compatibility).
# cp deploy.env.example deploy.env
#
# Full migrate guide: MIGRATE_AI_SERVER.md

TROOPER_HOST=connect01.trooper.ai
TROOPER_USER=trooperai
TROOPER_SSH_PORT=22539
AI_API_PORT=22528
REMOTE_DIR=prequaliq-ai

# Optional: for verify-from-mac.sh test call (must match GPU .env AI_API_KEY)
# AI_API_KEY=your-key-here
